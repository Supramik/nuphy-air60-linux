HTML_BODY = r"""<main class="sheet">
  <header class="top">
    <div class="ident">
      <h1 id="title"></h1>
      <p class="asof" id="asof"></p>
    </div>
    <div class="seg" id="modes" role="group" aria-label="Mode switch on the keyboard"></div>
  </header>
  <nav class="tabs" id="tabs" role="tablist" aria-label="Layers"></nav>
  <div class="board-scroll"><div class="board"><div class="keys" id="keys"></div></div></div>
  <div class="legend" id="legend"></div>
  <section class="detail" id="detail" aria-live="polite"></section>
  <p class="foot" id="foot"></p>
</main>
<script>
const MODEL = __MODEL__;
(() => {
  const M = MODEL, $ = id => document.getElementById(id);
  const esc = s => String(s).replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"})[c]);
  const color = r => ({base: "var(--ink)", ink: "var(--ink)", dim: "var(--muted)", muted: "var(--muted)", accent: "var(--accent)"})[r] || `var(--${r})`;
  let saved = {};
  try { saved = JSON.parse(localStorage.getItem("air60-keymap") || "{}"); } catch (e) {}
  const remember = () => { try { localStorage.setItem("air60-keymap", JSON.stringify({mode: M.modes[modeI].name, view: viewI})); } catch (e) {} };
  let modeI = M.modes.findIndex(m => m.name === (saved.mode || "Windows"));
  if (modeI < 0) modeI = 0;
  let viewI = Math.min(saved.view || 0, M.modes[modeI].views.length - 1);
  const overviewKeys = () => M.modes[modeI].views[0].keys;
  let selected = [...overviewKeys()].sort((a, b) => b.tip.length - a.tip.length)[0].i;

  // Pick the most descriptive legend variant that fits, measuring the real font.
  const ctx = document.createElement("canvas").getContext("2d");
  const capFont = getComputedStyle(document.documentElement).getPropertyValue("--font-cap").trim();
  const unit = 100 / M.board.w;  // one key unit in cqw
  const SPEC = {corner: [1.32, 600, 1, 0.9], cornerSmall: [0.98, 500, 1, 0.9], main: [1.4, 600, 2, 0.75], sub: [1.06, 600, 1, 0.9]};
  const measure = (text, weight, size) => { ctx.font = `${weight} 100px ${capFont}`; return ctx.measureText(text).width / 100 * size; };
  function pick(variants, avail, [size, weight, maxLines, comfort]) {
    const fits = (v, s) => { const lines = v.split("\n"); return lines.length <= maxLines && Math.max(...lines.map(l => measure(l, weight, s))) <= avail; };
    const comfortable = size * comfort, smallest = size * 0.6;
    for (const [low, high] of [[comfortable, size], [smallest, comfortable]]) {
      for (const v of variants) for (let s = high; s >= low - 1e-6; s -= 0.04) if (fits(v, s)) return [v, s];
    }
    return [variants[variants.length - 1].replace(/-\n/g, "").replace(/\/\n/g, "/").replace(/\n/g, " "), smallest];
  }

  function keyHTML(k, overview) {
    const avail = k.w * unit - 2.1;
    let corner = "", main = "", subs = "";
    for (const lg of k.legends) {
      const spec = lg.slot === "corner" ? (overview ? SPEC.corner : SPEC.cornerSmall) : SPEC[lg.slot];
      const [text, size] = pick(lg.v, avail, spec);
      const fade = lg.slot === "corner" && !overview ? ";opacity:.6" : "";
      const span = `<span class="lg ${lg.slot}" style="--c:${color(lg.role)};font-size:${size.toFixed(2)}cqw${fade}">${esc(text)}</span>`;
      if (lg.slot === "corner") corner += span; else if (lg.slot === "main") main += span; else subs += span;
    }
    const cls = ["key", k.tint && "tint", k.dim && "dim", k.held && "held"].filter(Boolean).join(" ");
    const label = k.tip.map(t => `${t.layer}: ${t.text}`).join(", ");
    return `<button type="button" class="${cls}" data-i="${k.i}" aria-pressed="${k.i === selected}" aria-label="${esc(label)}"
      style="--x:${k.x};--y:${k.y};--w:${k.w};--h:${k.h};--c:${color(k.tint || k.held || "ink")}"><span class="cap"></span><span class="face">${corner}${main}${subs && `<span class="subs">${subs}</span>`}</span></button>`;
  }

  function renderDetail() {
    const k = overviewKeys().find(k => k.i === selected) || overviewKeys()[0];
    $("detail").innerHTML = `<div class="big" aria-hidden="true">${esc(k.tip[0].text)}</div><div class="rows">` +
      k.tip.map(t => `<div class="row" style="--c:${color(t.role)}"><span class="who">${esc(t.layer)}</span>` +
        `<span class="what"><b>${esc(t.text)}</b> · ${esc(t.desc)}${t.note ? ` <em>(${esc(t.note)})</em>` : ""}<code>${esc(t.code)}</code></span></div>`).join("") + `</div>`;
  }

  function select(i) {
    selected = i;
    for (const b of $("keys").querySelectorAll("[data-i]")) b.setAttribute("aria-pressed", String(+b.dataset.i === i));
    renderDetail();
  }

  function render() {
    const mode = M.modes[modeI], view = mode.views[viewI];
    $("title").textContent = M.board.name;
    $("asof").textContent = M.source.asof;
    $("modes").innerHTML = M.modes.map((m, i) => `<button type="button" data-mode="${i}" aria-pressed="${i === modeI}">${esc(m.name)}</button>`).join("");
    $("tabs").innerHTML = mode.views.map((v, i) => `<button type="button" class="tab" role="tab" data-view="${i}" aria-selected="${i === viewI}" style="--c:${color(v.role)}">${esc(v.title)}${v.summary ? `<span class="sum">${esc(v.summary)}</span>` : ""}</button>`).join("");
    const keys = $("keys");
    keys.style.setProperty("--bw", M.board.w);
    keys.style.setProperty("--bh", M.board.h);
    keys.innerHTML = view.keys.map(k => keyHTML(k, view.id === "overview")).join("");
    $("legend").innerHTML = view.chips.map(([r, t]) => `<span class="chip${t.startsWith("Outlined") ? " ring" : r === "dim" ? " dim" : ""}" style="--c:${color(r)}"><i></i>${esc(t)}</span>`).join("");
    renderDetail();
  }

  $("modes").addEventListener("click", e => {
    const b = e.target.closest("[data-mode]"); if (!b) return;
    modeI = +b.dataset.mode; viewI = Math.min(viewI, M.modes[modeI].views.length - 1); remember(); render();
  });
  $("tabs").addEventListener("click", e => {
    const b = e.target.closest("[data-view]"); if (!b) return;
    viewI = +b.dataset.view; remember(); render();
  });
  $("tabs").addEventListener("keydown", e => {
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    const n = M.modes[modeI].views.length;
    viewI = (viewI + (e.key === "ArrowRight" ? 1 : n - 1)) % n; remember(); render();
    $("tabs").querySelector(`[data-view="${viewI}"]`).focus();
  });
  $("keys").addEventListener("click", e => { const b = e.target.closest("[data-i]"); if (b) select(+b.dataset.i); });
  $("keys").addEventListener("mouseover", e => { const b = e.target.closest("[data-i]"); if (b && +b.dataset.i !== selected) select(+b.dataset.i); });
  $("keys").addEventListener("focusin", e => { const b = e.target.closest("[data-i]"); if (b) select(+b.dataset.i); });

  const made = new Date(M.generated);
  $("foot").textContent = `Physical layout from NuPhy's VIA definition. Generated by nuphy-keymap on ${made.toLocaleDateString(undefined, {month: "short", day: "numeric", year: "numeric"})}.`;
  render();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(render);
})();
</script>
"""


def write_html(model: dict, path: Path, fragment: bool):
    data = json.dumps(model, ensure_ascii=False, separators=(",", ":")).replace("</", "<\\/")
    body = HTML_BODY.replace("__MODEL__", data)
    if fragment:  # Claude artifacts wrap the page in their own <html>/<head>
        page = HTML_HEAD + body
    else:
        page = ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
                '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">\n'
                f"{HTML_HEAD}</head>\n<body>\n{body}</body>\n</html>\n")
    path.write_text(page)


# ---------------------------------------------------------------------------
# Terminal output, sync and verify
# ---------------------------------------------------------------------------

def print_text(board: Board, km: Keymap, conns: list[str]):
    model = build_model(board, km, conns)
    print(f"{board.name}: {model['source']['headline']}")
    if km.note:
        print(f"  ({km.note})")
    for mode in find_modes(board, km.layers):
        print(f"\n=== {mode.name} ===")
        base = mode.layers[0]
        for info in mode.layers[1:]:
            print(f"\n{info.name}" + (f"  ({info.summary})" if info.summary else ""))
            cells = []
            for k in board.keys:
                code = km.layers[info.index][k.idx]
                if code in TRANSPARENT:
                    continue
                lab = describe(code, board, km.macros)
                if lab.link:
                    lab = link_legend(lab, mode, False)[0]
                pressed = flat(describe(km.layers[base.index][k.idx], board).variants[-1])
                cells.append(f"{pressed:>6}  {flat(lab.variants[0])}")
            for i in range(0, len(cells), 3):
                print("  " + "".join(c.ljust(28) for c in cells[i:i + 3]).rstrip())


def sync(board: Board, watch: bool):
    if not watch:
        layers, protocol = read_keyboard(board)
        path, changed = save_snapshot(board, layers, protocol)
        print(f"{'Saved a new snapshot' if changed else 'Unchanged; confirmed'}: {path}")
        return
    # Read when the cable goes in, right after VIA lets go of the keyboard (that's
    # when edits are done), and every few minutes as a fallback. In between, only
    # look at who has the device open, which costs about 10 ms.
    time.sleep(2)  # let every USB interface finish appearing
    next_read = 0.0  # monotonic time of the next read; 0 means as soon as possible
    while dev := find_via_hidraw(board):
        now = time.monotonic()
        if processes_using(dev):
            next_read = 0.0  # VIA is open: read as soon as it closes
        elif now >= next_read:
            try:
                layers, protocol = read_keyboard(board)
                if save_snapshot(board, layers, protocol)[1]:
                    notify("Keymap change saved", "The keymap overlay now shows your latest VIA changes.")
                next_read = now + WATCH_REREAD
            except Busy:
                pass  # VIA grabbed it in between; try again next round
            except NotPluggedIn:
                break  # the cable came out in between
            except (OSError, TimeoutError, RuntimeError) as e:
                print(f"read failed: {e}", file=sys.stderr)
                next_read = now + 30
        time.sleep(WATCH_POLL)


def verify(board: Board, against: Path | None):
    if against:
        ref = read_layout_file(against, board)
    else:
        ref = next((k for k in saved_keymaps(board) if k.source == "export"), None)
        if ref is None:
            sys.exit("No VIA export in via/ to compare with.")
    layers, protocol = read_keyboard(board)
    print(f"Keyboard: {len(layers)} layers, VIA protocol {protocol}. Comparing with {ref.path.name}")
    diffs = [(li, k, ref.layers[li][k.idx], layers[li][k.idx])
             for li in range(min(len(layers), len(ref.layers))) for k in board.keys
             if layers[li][k.idx] != ref.layers[li][k.idx]]
    for li, k, old, new in diffs:
        print(f"  layer {li}, key {k.idx:3}: file has {old}, keyboard has {new}")
    if len(layers) != len(ref.layers):
        print(f"  layer count differs: file {len(ref.layers)}, keyboard {len(layers)}")
    print("Identical." if not diffs and len(layers) == len(ref.layers) else f"{len(diffs)} differences.")


def main(argv: list[str] | None = None):
    ap = argparse.ArgumentParser(prog="nuphy-keymap", description=__doc__.split("\n\n")[0],
                                 epilog="\n\n".join(__doc__.split("\n\n")[1:]),
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--offline", action="store_true", help="don't query the keyboard, use the newest saved keymap")
    sub = ap.add_subparsers(dest="cmd", metavar="command")
    p_show = sub.add_parser("show", help="toggle the overlay (the default)")
    p_show.add_argument("--screenshot", type=Path, help=argparse.SUPPRESS)
    p_html = sub.add_parser("html", help="write the interactive web page")
    p_html.add_argument("file", nargs="?", type=Path, default=HTML_FILE)
    p_html.add_argument("--fragment", action="store_true", help="page content only, the way Claude artifacts take it")
    p_html.add_argument("--no-open", action="store_true", help="don't open it in the browser")
    sub.add_parser("text", help="print the layers in the terminal")
    p_sync = sub.add_parser("sync", help="read the keyboard over USB and save a snapshot")
    p_sync.add_argument("--watch", action="store_true", help="keep re-reading while it stays plugged in")
    p_verify = sub.add_parser("verify", help="compare the live keyboard with a saved keymap")
    p_verify.add_argument("file", nargs="?", type=Path)
    args = ap.parse_args(argv)
    cmd = args.cmd or "show"
    shot = getattr(args, "screenshot", None)

    if cmd == "show" and not shot and not claim_overlay():
        return  # an overlay was open; the shortcut closed it
    if not DEFINITION_FILE.exists():
        sys.exit(f"Missing {DEFINITION_FILE}. Download NuPhy's VIA file for your keyboard from "
                 f"{DEFINITIONS_URL} and save it there.")
    board = load_board()
    try:
        if cmd == "sync":
            return sync(board, args.watch)
        if cmd == "verify":
            return verify(board, args.file)
        km = get_keymap(board, live=not args.offline)
    except NotPluggedIn:
        sys.exit("The keyboard isn't plugged in by USB, which VIA needs.")
    except Busy as e:
        sys.exit(f"{e} has the keyboard open. Close VIA and try again.")
    except FileNotFoundError as e:
        sys.exit(f"Can't find {e.filename}.")
    conns = connections(board)
    if cmd == "text":
        return print_text(board, km, conns)
    model = build_model(board, km, conns)
    if cmd == "html":
        write_html(model, args.file, args.fragment)
        print(args.file)
        if not args.no_open:
            try:
                subprocess.Popen(["xdg-open", str(args.file)], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
            except OSError:
                pass  # no xdg-open: the path printed above is enough
        return
    try:
        run_overlay(model, shot)
    except ImportError as e:
        notify("NuPhy Keymap", f"The overlay needs PyQt6 ({e}). Try: nuphy-keymap html")
        raise


if __name__ == "__main__":
    try:
        main()
    except SystemExit as e:
        if isinstance(e.code, str) and not sys.stderr.isatty():
            notify("NuPhy Keymap", e.code)  # launched from the shortcut: no terminal to print to
        raise
