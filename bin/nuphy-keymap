#!/usr/bin/python3
"""nuphy-keymap - a visual, always-current cheat sheet for the NuPhy Air60 V2.

  nuphy-keymap               toggle the on-screen overlay (this is what the shortcut runs)
  nuphy-keymap html [FILE]   write the same view as an interactive web page
  nuphy-keymap text          print every layer in the terminal
  nuphy-keymap sync          read the keyboard over USB and save a snapshot
  nuphy-keymap verify        compare the live keyboard with the newest VIA export

Nothing about the keymap is hard-coded. Every run uses the freshest source:

  1. the keyboard itself, read over USB with the VIA protocol. Read-only, and
     possible without root thanks to the udev rule in system/50-nuphy.rules.
  2. the newest snapshot in snapshots/. Every live read refreshes it, so this
     is what you see over Bluetooth or the 2.4G dongle, which VIA can't reach.
  3. a VIA export (Save + Load > Save Current Layout) dropped into via/.

The physical layout and NuPhy's custom key names come from via/definition.json,
the same definition file VIA loads. These live in ~/.config/nuphy-air60, or in
$NUPHY_KEYMAP_HOME if that's set.
"""
from __future__ import annotations

import argparse
import colorsys
import datetime as dt
import fcntl
import html
import json
import os
import re
import select
import signal
import subprocess
import sys
import time
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path

DATA_DIR = Path(os.environ.get("NUPHY_KEYMAP_HOME")
                or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "nuphy-air60")
VIA_DIR = DATA_DIR / "via"
DEFINITION_FILE = VIA_DIR / "definition.json"
SNAPSHOT_DIR = DATA_DIR / "snapshots"
STATE_FILE = DATA_DIR / "state.json"
HTML_FILE = DATA_DIR / "keymap.html"
DEFINITIONS_URL = "https://nuphy.com/pages/json-files-for-nuphy-keyboards"
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
KEEP_SNAPSHOTS = 25
WATCH_POLL = 5  # sync --watch: seconds between checks of who has the keyboard open
WATCH_REREAD = 300  # ...and re-read at least this often, for changes made without VIA


# ---------------------------------------------------------------------------
# The board: physical layout from VIA's definition (KLE format)
# ---------------------------------------------------------------------------

@dataclass
class PhysKey:
    idx: int  # position in VIA's flat per-layer list: row * cols + col
    x: float
    y: float
    w: float
    h: float


@dataclass
class Board:
    name: str
    vid: int
    pid: int
    rows: int
    cols: int
    keys: list[PhysKey]
    custom: list[dict]  # VIA customKeycodes, indexed by CUSTOM(n)

    @property
    def width(self) -> float:
        return max(k.x + k.w for k in self.keys)

    @property
    def height(self) -> float:
        return max(k.y + k.h for k in self.keys)


def load_board(path: Path = DEFINITION_FILE) -> Board:
    d = json.loads(path.read_text())
    rows, cols = d["matrix"]["rows"], d["matrix"]["cols"]
    keys: list[PhysKey] = []
    y = 0.0
    for row in d["layouts"]["keymap"]:
        x, w, h, decal = 0.0, 1.0, 1.0, False
        for item in row:
            if isinstance(item, dict):  # properties for the next key
                x += item.get("x", 0)
                y += item.get("y", 0)
                w, h = item.get("w", w), item.get("h", h)
                decal = item.get("d", decal)
                continue
            legend = str(item).split("\n")
            option = legend[3] if len(legend) > 3 else ""  # VIA layout option "group,choice"
            if not decal and (not option or option.endswith(",0")):
                r, c = (int(v) for v in legend[0].split(","))
                keys.append(PhysKey(r * cols + c, x, y, w, h))
            x += w
            w, h, decal = 1.0, 1.0, False
        y += 1
    return Board(d["name"], int(d["vendorId"], 16), int(d["productId"], 16),
                 rows, cols, keys, d.get("customKeycodes", []))


# ---------------------------------------------------------------------------
# Where the keymap comes from
# ---------------------------------------------------------------------------

@dataclass
class Keymap:
    layers: list[list[str]]  # VIA keycode names, one list per layer
    source: str  # "usb", "snapshot" or "export"
    path: Path | None
    when: dt.datetime  # when this keymap was last known to be on the keyboard
    macros: list[str] = field(default_factory=list)
    note: str = ""  # why a live read didn't happen, when that's worth saying


def read_layout_file(path: Path, board: Board) -> Keymap:
    data = json.loads(path.read_text())
    vpid = data.get("vendorProductId")
    if vpid is not None and vpid != board.vid << 16 | board.pid:
        raise ValueError(f"{path.name} is for a different keyboard")
    layers = data.get("layers") or []
    if not layers or any(len(layer) != board.rows * board.cols for layer in layers):
        raise ValueError(f"{path.name} doesn't match the {board.rows}x{board.cols} matrix")
    source = "snapshot" if path.parent == SNAPSHOT_DIR else "export"
    when = dt.datetime.fromtimestamp(path.stat().st_mtime)
    return Keymap(layers, source, path, when, data.get("macros") or [])


def saved_keymaps(board: Board):
    """Snapshots and VIA exports, newest first."""
    files = [p for p in (*SNAPSHOT_DIR.glob("*.json"), *VIA_DIR.glob("*.json"))
             if p != DEFINITION_FILE]
    for path in sorted(files, key=lambda p: p.stat().st_mtime, reverse=True):
        try:
            yield read_layout_file(path, board)
        except (OSError, ValueError, KeyError, TypeError):
            continue


def save_snapshot(board: Board, layers: list[list[str]], protocol: int) -> tuple[Path, bool]:
    """Store a live read. Returns (path, whether the keymap changed)."""
    latest = next(saved_keymaps(board), None)
    changed = latest is None or latest.layers != layers
    if latest and latest.source == "snapshot" and not changed:
        os.utime(latest.path)  # same keymap: just mark it as confirmed now
        return latest.path, False
    SNAPSHOT_DIR.mkdir(parents=True, exist_ok=True)
    now = dt.datetime.now()
    path = SNAPSHOT_DIR / f"keymap-{now:%Y-%m-%d_%H%M%S}.layout.json"
    data = {  # VIA's own layout format, plus a note on where it came from
        "name": board.name,
        "vendorProductId": board.vid << 16 | board.pid,
        "macros": latest.macros if latest else [],
        "layers": layers,
        "encoders": [],
        "_nuphy_keymap": {
            "read": f"live over USB, VIA protocol {protocol}",
            "at": now.isoformat(timespec="seconds"),
            "macros": "carried over from the previous file, not read from the keyboard",
        },
    }
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, indent=1, ensure_ascii=False) + "\n")
    tmp.replace(path)
    for old in sorted(SNAPSHOT_DIR.glob("keymap-*.layout.json"))[:-KEEP_SNAPSHOTS]:
        old.unlink(missing_ok=True)
    return path, changed


class Busy(Exception):
    """Another program (normally VIA in the browser) has the keyboard open."""


class NotPluggedIn(Exception):
    """No VIA interface: the keyboard is off, or on Bluetooth or the 2.4G dongle."""


VIA_RAW_HID = (b"\x06\x60\xff", b"\x09\x61")  # HID usage page 0xFF60, usage 0x61


def find_via_hidraw(board: Board) -> Path | None:
    """The keyboard's VIA interface, present only when it's plugged in by USB."""
    for node in sorted(Path("/sys/class/hidraw").glob("hidraw*")):
        try:
            uevent = (node / "device" / "uevent").read_text()
            m = re.search(r"^HID_ID=(\w+):(\w+):(\w+)$", uevent, re.M)
            if not m or tuple(int(g, 16) for g in m.groups()) != (0x03, board.vid, board.pid):
                continue
            descriptor = (node / "device" / "report_descriptor").read_bytes()
        except OSError:
            continue
        if all(part in descriptor for part in VIA_RAW_HID):
            return Path("/dev") / node.name
    return None


def processes_using(dev: Path) -> list[str]:
    """Names of other processes holding dev open. Replies to a VIA request go
    to every reader, so querying while VIA is connected would confuse it."""
    me, target, users = os.getpid(), str(dev), []
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit() or int(proc.name) == me:
            continue
        try:
            fds = list((proc / "fd").iterdir())
        except OSError:
            continue
        for fd in fds:
            try:
                if os.readlink(fd) == target:
                    users.append((proc / "comm").read_text().strip())
                    break
            except OSError:
                pass
    return users


class ViaLink:
    """Minimal read-only VIA client: 32-byte raw HID reports over hidraw."""

    def __init__(self, dev: Path):
        self.fd = os.open(dev, os.O_RDWR | os.O_NONBLOCK)
        while self._read() is not None:  # drop anything already queued
            pass

    def close(self):
        os.close(self.fd)

    def _read(self) -> bytes | None:
        try:
            return os.read(self.fd, 64)
        except BlockingIOError:
            return None

    def ask(self, *request: int, echo: int = 1, timeout: float = 0.8) -> bytes:
        msg = bytes(request).ljust(32, b"\0")
        os.write(self.fd, b"\0" + msg)  # the leading 0 is the (unused) report ID
        deadline = time.monotonic() + timeout
        while (left := deadline - time.monotonic()) > 0:
            if not select.select([self.fd], [], [], left)[0]:
                break
            reply = self._read()
            if not reply:
                continue
            if reply[0] == 0xFF and reply[1:echo] == msg[1:echo]:
                raise RuntimeError(f"the keyboard doesn't support VIA command 0x{request[0]:02x}")
            if reply[:echo] == msg[:echo]:
                return reply
        raise TimeoutError("the keyboard didn't answer")


def read_keyboard(board: Board) -> tuple[list[list[str]], int]:
    """Read every layer straight from the keyboard. Returns (layers, VIA protocol)."""
    dev = find_via_hidraw(board)
    if dev is None:
        raise NotPluggedIn("not plugged in by USB")
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    with open(RUNTIME_DIR / "nuphy-keymap-hid.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # one reader of ours at a time
        if users := processes_using(dev):
            raise Busy(", ".join(sorted(set(users))))
        link = ViaLink(dev)
        try:
            reply = link.ask(0x01)  # id_get_protocol_version
            protocol = reply[1] << 8 | reply[2]
            count = link.ask(0x11)[1]  # id_dynamic_keymap_get_layer_count
            size = count * board.rows * board.cols * 2
            raw = bytearray()
            for offset in range(0, size, 28):  # id_dynamic_keymap_get_buffer, 28 bytes a time
                n = min(28, size - offset)
                reply = link.ask(0x12, offset >> 8, offset & 0xFF, n, echo=3)
                raw += reply[4:4 + n]
        finally:
            link.close()
    decode = keycode_decoder(protocol)
    codes = [decode(raw[i] << 8 | raw[i + 1]) for i in range(0, len(raw), 2)]
    per_layer = board.rows * board.cols
    return [codes[i:i + per_layer] for i in range(0, len(codes), per_layer)], protocol


def get_keymap(board: Board, live: bool = True) -> Keymap:
    note = ""
    if live:
        try:
            layers, protocol = read_keyboard(board)
            path, _ = save_snapshot(board, layers, protocol)
            saved = read_layout_file(path, board)
            return Keymap(layers, "usb", path, dt.datetime.now(), saved.macros)
        except NotPluggedIn:
            pass
        except Busy as e:
            note = f"{e} has the keyboard open (VIA?), so this is the last snapshot"
        except (OSError, TimeoutError, RuntimeError) as e:
            note = f"couldn't read it over USB: {e}"
    km = next(saved_keymaps(board), None)
    if km is None:
        sys.exit(f"No keymap yet. Plug the keyboard in by USB once, or put a VIA export in {VIA_DIR}")
    km.note = note
    return km


def connections(board: Board) -> list[str]:
    """How the keyboard is attached right now, from the kernel's input devices."""
    try:
        text = Path("/proc/bus/input/devices").read_text()
    except OSError:
        return []
    found: list[str] = []
    for block in text.split("\n\n"):
        m = re.search(r"Bus=(\w{4}) Vendor=(\w{4}) Product=(\w{4})", block)
        if not m or int(m.group(2), 16) != board.vid:
            continue
        bus, pid = int(m.group(1), 16), int(m.group(3), 16)
        kind = ("Bluetooth" if bus == 0x05 else "USB" if pid == board.pid
                else "2.4G dongle" if bus == 0x03 else "")
        if kind and kind not in found:
            found.append(kind)
    return found


# ---------------------------------------------------------------------------
# Keycodes: 16-bit values from the keyboard -> the names VIA uses in exports
# ---------------------------------------------------------------------------

def _basic_names(protocol: int) -> dict[int, str]:
    t = {0x00: "KC_NO", 0x01: "KC_TRNS"}
    t.update({0x04 + i: f"KC_{c}" for i, c in enumerate("ABCDEFGHIJKLMNOPQRSTUVWXYZ")})
    t.update({0x1E + i: f"KC_{c}" for i, c in enumerate("1234567890")})
    t.update({0x3A + i: f"KC_F{i + 1}" for i in range(12)})
    t.update({0x68 + i: f"KC_F{i + 13}" for i in range(12)})
    t.update({0x59 + i: f"KC_P{i + 1}" for i in range(9)})
    t.update({
        0x28: "KC_ENT", 0x29: "KC_ESC", 0x2A: "KC_BSPC", 0x2B: "KC_TAB", 0x2C: "KC_SPC",
        0x2D: "KC_MINS", 0x2E: "KC_EQL", 0x2F: "KC_LBRC", 0x30: "KC_RBRC", 0x31: "KC_BSLS",
        0x32: "KC_NUHS", 0x33: "KC_SCLN", 0x34: "KC_QUOT", 0x35: "KC_GRV", 0x36: "KC_COMM",
        0x37: "KC_DOT", 0x38: "KC_SLSH", 0x39: "KC_CAPS", 0x46: "KC_PSCR", 0x47: "KC_SLCK",
        0x48: "KC_PAUS", 0x49: "KC_INS", 0x4A: "KC_HOME", 0x4B: "KC_PGUP", 0x4C: "KC_DEL",
        0x4D: "KC_END", 0x4E: "KC_PGDN", 0x4F: "KC_RGHT", 0x50: "KC_LEFT", 0x51: "KC_DOWN",
        0x52: "KC_UP", 0x53: "KC_NLCK", 0x54: "KC_PSLS", 0x55: "KC_PAST", 0x56: "KC_PMNS",
        0x57: "KC_PPLS", 0x58: "KC_PENT", 0x62: "KC_P0", 0x63: "KC_PDOT", 0x64: "KC_NUBS",
        0x65: "KC_APP", 0x66: "KC_POWER", 0x67: "KC_PEQL", 0x74: "KC_EXEC", 0x75: "KC_HELP",
        0x76: "KC_MENU", 0x77: "KC_SLCT", 0x78: "KC_STOP", 0x79: "KC_AGIN", 0x7A: "KC_UNDO",
        0x7B: "KC_CUT", 0x7C: "KC_COPY", 0x7D: "KC_PSTE", 0x7E: "KC_FIND",
        0xA5: "KC_PWR", 0xA6: "KC_SLEP", 0xA7: "KC_WAKE", 0xA8: "KC_MUTE", 0xA9: "KC_VOLU",
        0xAA: "KC_VOLD", 0xAB: "KC_MNXT", 0xAC: "KC_MPRV", 0xAD: "KC_MSTP", 0xAE: "KC_MPLY",
        0xAF: "KC_MSEL", 0xB0: "KC_EJCT", 0xB1: "KC_MAIL", 0xB2: "KC_CALC", 0xB3: "KC_MYCM",
        0xB4: "KC_WSCH", 0xB5: "KC_WHOM", 0xB6: "KC_WBAK", 0xB7: "KC_WFWD", 0xB8: "KC_WSTP",
        0xB9: "KC_WREF", 0xBA: "KC_WFAV", 0xBB: "KC_MFFD", 0xBC: "KC_MRWD", 0xBD: "KC_BRIU",
        0xBE: "KC_BRID",
        0xE0: "KC_LCTL", 0xE1: "KC_LSFT", 0xE2: "KC_LALT", 0xE3: "KC_LGUI",
        0xE4: "KC_RCTL", 0xE5: "KC_RSFT", 0xE6: "KC_RALT", 0xE7: "KC_RGUI",
    })
    mouse = ["KC_MS_UP", "KC_MS_DOWN", "KC_MS_LEFT", "KC_MS_RIGHT",
             "KC_MS_BTN1", "KC_MS_BTN2", "KC_MS_BTN3", "KC_MS_BTN4", "KC_MS_BTN5"]
    wheel = ["KC_MS_WH_UP", "KC_MS_WH_DOWN", "KC_MS_WH_LEFT", "KC_MS_WH_RIGHT",
             "KC_MS_ACCEL0", "KC_MS_ACCEL1", "KC_MS_ACCEL2"]
    if protocol >= 11:  # QMK 0.19+ renumbered the mouse keys
        t.update({0xBF: "KC_CPNL", 0xC0: "KC_ASST", 0xC1: "KC_MCTL", 0xC2: "KC_LPAD"})
        t.update({0xCD + i: n for i, n in enumerate(mouse)})
        t.update({0xD6: "KC_MS_BTN6", 0xD7: "KC_MS_BTN7", 0xD8: "KC_MS_BTN8"})
        t.update({0xD9 + i: n for i, n in enumerate(wheel)})
    else:
        t.update({0xF0 + i: n for i, n in enumerate(mouse)})
        t.update({0xF9 + i: n for i, n in enumerate(wheel)})
    return t


_RGB = ["RGB_TOG", "RGB_MOD", "RGB_RMOD", "RGB_HUI", "RGB_HUD", "RGB_SAI", "RGB_SAD",
        "RGB_VAI", "RGB_VAD", "RGB_SPI", "RGB_SPD", "RGB_M_P", "RGB_M_B", "RGB_M_R",
        "RGB_M_SW", "RGB_M_SN", "RGB_M_K", "RGB_M_X", "RGB_M_G", "RGB_M_T", "RGB_M_TW"]
_BACKLIGHT_V12 = ["BL_ON", "BL_OFF", "BL_TOGG", "BL_DOWN", "BL_UP", "BL_STEP", "BL_BRTG"]
_BACKLIGHT_V10 = ["BL_ON", "BL_OFF", "BL_DOWN", "BL_UP", "BL_TOGG", "BL_STEP", "BL_BRTG"]
NAMED_V12 = {0x7800 + i: n for i, n in enumerate(_BACKLIGHT_V12)}
NAMED_V12.update({0x7820 + i: n for i, n in enumerate(_RGB)})
NAMED_V12.update({0x7C00: "QK_BOOT", 0x7C01: "QK_REBOOT", 0x7C16: "QK_GESC"})
NAMED_V10 = {0x5CBB + i: n for i, n in enumerate(_BACKLIGHT_V10)}
NAMED_V10.update({0x5CC2 + i: n for i, n in enumerate(_RGB)})
NAMED_V10.update({0x5C00: "QK_BOOT"})


def _mods(bits: int) -> list[str]:
    side = "R" if bits & 0x10 else "L"
    return [side + n for b, n in ((1, "CTL"), (2, "SFT"), (4, "ALT"), (8, "GUI")) if bits & b]


def keycode_decoder(protocol: int):
    """VIA protocol 11+ (QMK 0.19 and later) uses QMK's current numbering, though
    11 kept macros and custom keycodes higher up; older firmware uses the "v10"
    layout. Unknown values come back as hex."""
    basic = _basic_names(protocol)
    modern = protocol >= 11
    macro, custom = (0x7700, 0x7E00) if protocol >= 12 else (0x7702, 0x7F00)

    def kc(b: int) -> str:
        return basic.get(b, f"0x{b:02x}")

    def mask(bits: int) -> str:
        return "|".join("MOD_" + m for m in _mods(bits)) or "0"

    def decode(code: int) -> str:
        if code in basic:
            return basic[code]
        if 0x0100 <= code <= 0x1FFF:  # modifiers + key, e.g. LCTL(LSFT(KC_K))
            name = kc(code & 0xFF)
            for mod in reversed(_mods(code >> 8 & 0x1F)):
                name = f"{mod}({name})"
            return name
        if 0x4000 <= code <= 0x4FFF:
            return f"LT({code >> 8 & 0xF},{kc(code & 0xFF)})"
        if modern:
            if 0x2000 <= code <= 0x3FFF:
                return f"MT({mask(code >> 8 & 0x1F)},{kc(code & 0xFF)})"
            if 0x5000 <= code <= 0x51FF:
                return f"LM({code >> 5 & 0xF},{mask(code & 0x1F)})"
            for start, op in ((0x5200, "TO"), (0x5220, "MO"), (0x5240, "DF"),
                              (0x5260, "TG"), (0x5280, "OSL"), (0x52C0, "TT")):
                if start <= code < start + 0x20:
                    return f"{op}({code - start})"
            if 0x52A0 <= code <= 0x52BF:
                return f"OSM({mask(code & 0x1F)})"
            if macro <= code < macro + 0x20:
                return f"MACRO({code - macro})"
            if custom <= code < custom + 0x20:
                return f"CUSTOM({code - custom})"
            return NAMED_V12.get(code, f"0x{code:04x}")
        if 0x6000 <= code <= 0x7FFF:
            return f"MT({mask(code >> 8 & 0x1F)},{kc(code & 0xFF)})"
        if 0x5000 <= code <= 0x50FF:
            return f"TO({code & 0xF})"
        ops = {0x51: "MO", 0x52: "DF", 0x53: "TG", 0x54: "OSL", 0x58: "TT"}
        if code >> 8 in ops:
            return f"{ops[code >> 8]}({code & 0x1F})"
        if 0x5500 <= code <= 0x55FF:
            return f"OSM({mask(code & 0x1F)})"
        if 0x5900 <= code <= 0x59FF:
            return f"LM({code >> 4 & 0xF},{mask(code & 0xF)})"
        if 0x5F12 <= code < 0x5F22:
            return f"MACRO({code - 0x5F12})"
        if 0x5F80 <= code < 0x5FA0:
            return f"CUSTOM({code - 0x5F80})"
        return NAMED_V10.get(code, f"0x{code:04x}")

    return decode


# ---------------------------------------------------------------------------
# Labels: what to print on each keycap
# ---------------------------------------------------------------------------
# Variants run from most to least descriptive and "\n" breaks a line; the
# renderers print the first one that fits the keycap at a readable size.

@dataclass
class Label:
    variants: tuple[str, ...]
    tip: str
    kind: str
    link: tuple[str, int] | None = None  # (op, layer) for layer keys like MO(4)


SIMPLE: dict[str, tuple[tuple[str, ...], str, str]] = {
    "KC_ESC": (("Esc",), "Escape", "base"),
    "KC_TAB": (("Tab",), "Tab", "base"),
    "KC_CAPS": (("Caps Lock", "Caps"), "Caps Lock", "base"),
    "KC_BSPC": (("Backspace", "Bksp"), "Backspace", "base"),
    "KC_DEL": (("Del",), "Delete", "base"),
    "KC_ENT": (("Enter",), "Enter", "base"),
    "KC_SPC": (("Space",), "Space", "base"),
    "KC_LSFT": (("Shift",), "Left Shift", "base"),
    "KC_RSFT": (("Shift",), "Right Shift", "base"),
    "KC_LCTL": (("Ctrl",), "Left Ctrl", "base"),
    "KC_RCTL": (("Ctrl",), "Right Ctrl", "base"),
    "KC_LALT": (("Alt",), "Left Alt (Option on a Mac)", "base"),
    "KC_RALT": (("Alt",), "Right Alt / AltGr", "base"),
    "KC_LGUI": (("Meta",), "Left Meta, the Super / Windows / Command key", "base"),
    "KC_RGUI": (("Meta",), "Right Meta, the Super / Windows / Command key", "base"),
    "KC_APP": (("Menu",), "Context menu", "base"),
    "KC_UP": (("↑",), "Arrow up", "base"),
    "KC_DOWN": (("↓",), "Arrow down", "base"),
    "KC_LEFT": (("←",), "Arrow left", "base"),
    "KC_RGHT": (("→",), "Arrow right", "base"),
    "KC_GRV": (("`",), "Backtick (with Shift: ~)", "base"),
    "KC_MINS": (("-",), "Minus (with Shift: _)", "base"),
    "KC_EQL": (("=",), "Equals (with Shift: +)", "base"),
    "KC_LBRC": (("[",), "Left bracket (with Shift: {)", "base"),
    "KC_RBRC": (("]",), "Right bracket (with Shift: })", "base"),
