ALIASES = {
    "KC_TRANSPARENT": "KC_TRNS", "_______": "KC_TRNS", "XXXXXXX": "KC_NO",
    "KC_ENTER": "KC_ENT", "KC_ESCAPE": "KC_ESC", "KC_BACKSPACE": "KC_BSPC",
    "KC_SPACE": "KC_SPC", "KC_DELETE": "KC_DEL", "KC_RIGHT": "KC_RGHT", "KC_SCRL": "KC_SLCK",
    "KC_NUM": "KC_NLCK", "KC_LCMD": "KC_LGUI", "KC_RCMD": "KC_RGUI", "KC_LWIN": "KC_LGUI",
    "KC_RWIN": "KC_RGUI", "KC_LOPT": "KC_LALT", "KC_ROPT": "KC_RALT",
    "KC_AUDIO_MUTE": "KC_MUTE", "KC_AUDIO_VOL_UP": "KC_VOLU", "KC_AUDIO_VOL_DOWN": "KC_VOLD",
    "KC_MEDIA_PLAY_PAUSE": "KC_MPLY", "KC_MEDIA_NEXT_TRACK": "KC_MNXT",
    "KC_MEDIA_PREV_TRACK": "KC_MPRV", "KC_BRIGHTNESS_UP": "KC_BRIU",
    "KC_BRIGHTNESS_DOWN": "KC_BRID", "KC_SYSTEM_POWER": "KC_PWR",
    "KC_MS_U": "KC_MS_UP", "KC_MS_D": "KC_MS_DOWN", "KC_MS_L": "KC_MS_LEFT",
    "KC_MS_R": "KC_MS_RIGHT", "KC_BTN1": "KC_MS_BTN1", "KC_BTN2": "KC_MS_BTN2",
    "KC_BTN3": "KC_MS_BTN3", "KC_WH_U": "KC_MS_WH_UP", "KC_WH_D": "KC_MS_WH_DOWN",
    "KC_WH_L": "KC_MS_WH_LEFT", "KC_WH_R": "KC_MS_WH_RIGHT",
    "RGB_MODE_FORWARD": "RGB_MOD", "RGB_MODE_REVERSE": "RGB_RMOD", "KC_GESC": "QK_GESC",
    "RESET": "QK_BOOT",
}

MOD_WRAPPERS = {
    "LCTL": ("Ctrl",), "RCTL": ("RCtrl",), "LSFT": ("Shift",), "RSFT": ("RShift",),
    "LALT": ("Alt",), "LOPT": ("Alt",), "RALT": ("AltGr",), "ROPT": ("AltGr",),
    "LGUI": ("Meta",), "LCMD": ("Meta",), "LWIN": ("Meta",),
    "RGUI": ("RMeta",), "RCMD": ("RMeta",), "RWIN": ("RMeta",),
    "C_S": ("Ctrl", "Shift"), "LCS": ("Ctrl", "Shift"), "MEH": ("Ctrl", "Shift", "Alt"),
    "HYPR": ("Ctrl", "Shift", "Alt", "Meta"), "LCA": ("Ctrl", "Alt"), "LSA": ("Shift", "Alt"),
    "LSG": ("Shift", "Meta"), "SGUI": ("Shift", "Meta"), "SCMD": ("Shift", "Meta"),
    "SWIN": ("Shift", "Meta"), "LAG": ("Alt", "Meta"), "LCG": ("Ctrl", "Meta"),
    "LCAG": ("Ctrl", "Alt", "Meta"), "LSAG": ("Shift", "Alt", "Meta"),
    "RCS": ("RCtrl", "RShift"), "RSA": ("RShift", "AltGr"), "SAGR": ("RShift", "AltGr"),
    "RSG": ("RShift", "RMeta"), "RAG": ("AltGr", "RMeta"),
}
MOD_MASKS = {f"MOD_{k}": v for k, v in MOD_WRAPPERS.items() if len(k) == 4}
MOD_ORDER = ("Meta", "RMeta", "Ctrl", "RCtrl", "Alt", "AltGr", "Shift", "RShift")  # KDE's order
LAYER_VERBS = {"MO": "Hold for", "TT": "Hold (or tap twice to lock) for", "LT": "Hold for",
               "LM": "Hold for", "OSL": "Tap once for", "TG": "Toggle", "TO": "Switch to",
               "DF": "Make default:"}
TRANSPARENT = {"KC_TRNS", "KC_TRANSPARENT", "_______"}


def flat(text: str) -> str:
    return text.replace("-\n", "").replace("/\n", "/").replace("\n", " ")


def _sort_mods(mods) -> list[str]:
    return sorted(set(mods), key=MOD_ORDER.index)


def describe(code: str, board: Board, macros=()) -> Label:
    code = ALIASES.get(code, code)
    if code in TRANSPARENT:
        return Label(("▽",), "Transparent: uses the key from the layer below", "trns")
    if code == "KC_NO":
        return Label(("✕",), "Does nothing on this layer", "none")
    if code in SIMPLE:
        variants, tip, kind = SIMPLE[code]
        return Label(variants, tip, kind)
    if m := re.fullmatch(r"KC_([A-Z0-9])", code):
        return Label((m[1],), m[1], "base")
    if m := re.fullmatch(r"KC_F(\d+)", code):
        return Label((f"F{m[1]}",), f"F{m[1]}", "fkey")
    if m := re.fullmatch(r"(MO|TG|TO|TT|OSL|DF)\((\d+)\)", code):
        return Label((f"L{m[2]}",), f"{LAYER_VERBS[m[1]]} layer {m[2]}", "layer", (m[1], int(m[2])))
    if m := re.fullmatch(r"LT\(?(\d+)[,(]\s*(\w+)\)", code):  # LT(4,KC_A) or LT4(KC_A)
        tap = flat(describe(m[2], board, macros).variants[-1])
        return Label((f"{tap}\nhold L{m[1]}", f"{tap} / L{m[1]}"),
                     f"Tap: {tap}. Hold: layer {m[1]}", "layer", ("LT", int(m[1])))
    if m := re.fullmatch(r"LM\((\d+),\s*([\w|]+)\)", code):
        return Label((f"L{m[1]}",), f"Hold for layer {m[1]} with modifiers", "layer", ("LM", int(m[1])))
    if m := re.fullmatch(r"CUSTOM\((\d+)\)", code):
        n = int(m[1])
        entry = board.custom[n] if n < len(board.custom) else {}
        title = entry.get("title", f"Custom {n}")
        if title in NUPHY:
            variants, tip, kind = NUPHY[title]
            return Label(variants, tip, kind)
        name = entry.get("name", f"Custom\n{n}")
        return Label((name, flat(name)), title, "other")
    if m := re.fullmatch(r"MACRO\((\d+)\)|M(\d+)", code):
        n = int(m[1] or m[2])
        text = macros[n] if n < len(macros) else ""
        return Label((f"Macro\n{n}", f"Macro {n}", f"M{n}"),
                     f"Macro {n}" + (f": {text}" if text else ""), "macro")
    mods, inner = [], code
    while (m := re.fullmatch(r"([A-Z_]+)\((.+)\)", inner)) and m[1] in MOD_WRAPPERS:
        mods += MOD_WRAPPERS[m[1]]
        inner = m[2]
    if mods:
        key = flat(describe(inner, board, macros).variants[-1])
        combo = "+".join(_sort_mods(mods))
        short = "".join(x[0] for x in _sort_mods(mods))
        return Label((f"{combo}+\n{key}", f"{combo}+{key}", f"{short}+{key}"),
                     f"Sends {combo}+{key}", "shortcut")
    if m := re.fullmatch(r"([A-Z_]+?)_T\((\w+)\)", code):  # LCTL_T(KC_A)
        hold = MOD_WRAPPERS.get(m[1])
        if hold:
            tap = flat(describe(m[2], board, macros).variants[-1])
            held = "+".join(_sort_mods(hold))
            return Label((f"{tap}\n{held}", f"{tap} / {held}"),
                         f"Tap: {tap}. Hold: {held}", "shortcut")
    if m := re.fullmatch(r"MT\(([\w|]+),\s*(\w+)\)", code):
        hold = [x for part in m[1].split("|") for x in MOD_MASKS.get(part.strip(), ())]
        tap = flat(describe(m[2], board, macros).variants[-1])
        held = "+".join(_sort_mods(hold)) or "mod"
        return Label((f"{tap}\n{held}", f"{tap} / {held}"), f"Tap: {tap}. Hold: {held}", "shortcut")
    if code.lower().startswith("0x"):
        return Label((code.lower(),), f"Keycode {code} (not in this viewer's tables)", "other")
    return Label((re.sub(r"^(KC|QK)_", "", code),), code, "other")


# ---------------------------------------------------------------------------
# Layers: how they connect, and what each view shows
# ---------------------------------------------------------------------------

@dataclass
class LayerInfo:
    index: int
    stack: list[int]  # layers active while this one is on, topmost first
    name: str  # "Fn + Shift"
    role: str  # color slot: "base", "l1", "l2", ...
    held: list[int]  # physical keys you hold to get here
    summary: str = ""


@dataclass
class Mode:
    name: str  # "Windows" / "Mac", from the switch on the keyboard's side
    layers: list[LayerInfo]


SUMMARIES = {"side": "side lights", "light": "backlight", "mouse": "mouse keys",
             "fkey": "F-keys", "media": "media keys", "connect": "connections"}


def effective(layers: list[list[str]], stack: list[int], idx: int) -> str:
    for li in stack:
        if layers[li][idx] not in TRANSPARENT:
            return layers[li][idx]
    return "KC_NO"


def mode_name(board: Board, layer: list[str]) -> str | None:
    """NuPhy keeps a Mac and a Windows base layer; the bottom row tells them apart."""
    bottom = max(k.y for k in board.keys)
    x = {ALIASES.get(layer[k.idx], layer[k.idx]): k.x for k in reversed(board.keys) if k.y == bottom}
    if "KC_LGUI" in x and "KC_LALT" in x:
        return "Windows" if x["KC_LGUI"] < x["KC_LALT"] else "Mac"
    return None


def summarize(board: Board, layer: list[str]) -> str:
    kinds = Counter(describe(layer[k.idx], board).kind for k in board.keys
                    if layer[k.idx] not in TRANSPARENT)
    kinds.pop("layer", None)
    if not kinds:
        return ""
    kind, n = kinds.most_common(1)[0]
    return SUMMARIES.get(kind, "") if n >= 3 and n / sum(kinds.values()) >= 0.6 else ""


def find_modes(board: Board, layers: list[list[str]]) -> list[Mode]:
    """Base layers are the non-empty ones no other layer points to. From each,
    follow the layer keys (MO, TT, ...) to name the layers by how you reach them."""
    def link(code: str):
        return describe(code, board).link

    reached = {ln[1] for li, layer in enumerate(layers) for k in board.keys
               if (ln := link(layer[k.idx])) and ln[1] != li}
    modes = []
    for b, base in enumerate(layers):
        if b in reached or all(c in TRANSPARENT or c == "KC_NO" for c in (base[k.idx] for k in board.keys)):
            continue
        root = LayerInfo(b, [b], "Base", "base", [])
        infos, seen, queue = [root], {b}, [root]
        while queue:
            cur = queue.pop(0)
            targets: dict[int, list[int]] = {}
            for k in board.keys:
                ln = link(effective(layers, cur.stack, k.idx))
                if ln and ln[1] not in seen and ln[1] < len(layers):
                    targets.setdefault(ln[1], []).append(k.idx)
            for t, idxs in targets.items():
                seen.add(t)
                if cur is root:
                    n = sum(1 for i in infos if i.stack[1:] == [b])
                    name = "Fn" if n == 0 else f"Fn {n + 1}"
                else:
                    pressed = flat(describe(base[idxs[0]], board).variants[-1])
                    name = f"{cur.name} + {pressed}"
                info = LayerInfo(t, [t, *cur.stack], name, f"l{min(len(infos), 6)}", [*cur.held, *idxs])
                infos.append(info)
                queue.append(info)
        for info in infos[1:]:
            info.summary = summarize(board, layers[info.index])
        modes.append(Mode(mode_name(board, base) or f"Layer {b}", infos))
    return modes


def link_legend(label: Label, mode: Mode, in_base: bool) -> tuple[Label, str]:
    """Relabel a layer key with the layer's name, colored like the layer it opens."""
    op, n = label.link
    info = next((i for i in mode.layers if i.index == n), None)
    if info is None:
        return Label((f"Layer {n}", f"L{n}"), label.tip, "layer", label.link), "muted"
    tip = f"{LAYER_VERBS.get(op, 'Hold for')} the {info.name} layer"
    if info.summary:
        tip += f" ({info.summary})"
    if in_base:
        return Label((info.name,), tip, "layer", label.link), "base"
    target = info.summary.capitalize() if info.summary else info.name
    compact = target.replace(" + ", "+")
    variants = [f"▸ {target}", f"▸ {compact}"]
    if info.summary and " " in target:
        first, rest = target.split(" ", 1)
        variants += [f"▸ {first}\n{rest}", f"▸ {first}"]
    elif not info.summary:
        variants.append(f"{compact}\nlayer")
    return Label(tuple(dict.fromkeys(variants)), tip, "layer", label.link), info.role


def tip_entry(layer: str, role: str, label: Label, code: str, note: str = "") -> dict:
    return {"layer": layer, "role": role, "text": flat(label.variants[0]),
            "desc": label.tip, "code": code, "note": note}


def build_views(board: Board, km: Keymap, mode: Mode) -> list[dict]:
    layers, base = km.layers, mode.layers[0]

    def label_of(code: str, from_base: bool) -> tuple[Label, str | None]:
        lab = describe(code, board, km.macros)
        if lab.link:
            return link_legend(lab, mode, from_base)
        return lab, None

    def geometry(k: PhysKey) -> dict:
        return {"i": k.idx, "x": k.x, "y": k.y, "w": k.w, "h": k.h}

    # Overview: one keyboard, every layer's legend on the keycap, like printed side legends
    keys = []
    for k in board.keys:
        bcode = layers[base.index][k.idx]
        blab, _ = label_of(bcode, True)
        legends = [{"v": blab.variants, "role": "base", "slot": "corner"}]
        tip = [tip_entry("Base", "base", blab, bcode)]
        for info in mode.layers[1:]:
            code = layers[info.index][k.idx]
            if code in TRANSPARENT or code == effective(layers, info.stack[1:], k.idx):
                continue
            lab, link_role = label_of(code, False)
            legends.append({"v": lab.variants, "role": link_role or info.role, "slot": "sub"})
            tip.append(tip_entry(info.name, info.role, lab, code))
        keys.append({**geometry(k), "legends": legends, "tint": None, "dim": False,
                     "held": None, "tip": tip})
    chips = [["base", "Base layer"]] + [[i.role, f"Hold {i.name}"] for i in mode.layers[1:]]
    views = [{"id": "overview", "title": "Overview", "role": "accent", "summary": "",
              "chips": chips, "keys": keys}]

    # One view per layer: what each key does while that layer is on
    for info in mode.layers:
        is_base = info is base
        parent = next((i for i in mode.layers if i.index == info.stack[1]), base) if len(info.stack) > 1 else base
        keys = []
        for k in board.keys:
            code = layers[info.index][k.idx]
            eff = effective(layers, info.stack, k.idx)
            source = next((li for li in info.stack if layers[li][k.idx] not in TRANSPARENT), info.index)
            lab, _ = label_of(eff, source == base.index)
            blab, _ = label_of(layers[base.index][k.idx], True)
            defined = is_base or code not in TRANSPARENT
            held = k.idx in info.held
            if held:
                legends = [{"v": blab.variants, "role": info.role, "slot": "main"}]
            elif is_base:
                legends = [{"v": lab.variants, "role": "base", "slot": "main"}]
            elif defined:
                legends = [{"v": blab.variants, "role": "base", "slot": "corner"},
                           {"v": lab.variants, "role": "ink", "slot": "main"}]
            else:
                legends = [{"v": lab.variants, "role": "dim", "slot": "main"}]
            from_name = next((i.name for i in mode.layers if i.index == source), f"layer {source}")
            note = "" if defined or held else f"falls through from {from_name}"
            if held:
                note = "hold this to get here"
            tip = [tip_entry(info.name, info.role, lab, eff, note)]
            if not is_base:
                tip.append(tip_entry("Base", "base", blab, layers[base.index][k.idx]))
            keys.append({**geometry(k), "legends": legends,
                         "tint": info.role if defined and not is_base and not held else None,
                         "dim": not defined and not held,
                         "held": info.role if held else None, "tip": tip})
        if is_base:
            chips = [["base", f"{mode.name} base layer: what the keys type with nothing held"]]
        else:
            chips = [[info.role, f"Changed on {info.name}"],
                     ["dim", f"Same as {parent.name}"],
                     [info.role, "Outlined: hold these"]]
        views.append({"id": f"layer{info.index}", "title": info.name, "role": info.role,
                      "summary": info.summary, "chips": chips, "keys": keys})
    return views


def friendly_time(t: dt.datetime) -> str:
    today = dt.date.today()
    if t.date() == today:
        return f"today at {t:%H:%M}"
    if t.date() == today - dt.timedelta(days=1):
        return f"yesterday at {t:%H:%M}"
    if t.year == today.year:
        return f"on {t:%b} {t.day}"
    return f"on {t:%b} {t.day}, {t.year}"


def build_model(board: Board, km: Keymap, conns: list[str]) -> dict:
    link = " + ".join(conns) if conns else "Not connected"
    when = f"{km.when:%b} {km.when.day}, {km.when.year} at {km.when:%H:%M}"
    if km.source == "usb":
        headline = "Live from the keyboard over USB"
        asof = f"Read from the keyboard on {when}"
    elif km.source == "snapshot":
        headline = f"{link} · last read from the keyboard {friendly_time(km.when)}"
        asof = f"Last read from the keyboard on {when}"
    else:
        headline = f"{link} · from the VIA export {friendly_time(km.when)}"
        asof = f"From a VIA export dated {when}"
    if km.source != "usb" and "USB" not in conns:
        headline += " · plug in USB to refresh"
    return {
        "board": {"name": board.name, "w": board.width, "h": board.height},
        "source": {"kind": km.source, "headline": headline, "asof": asof, "note": km.note},
        "generated": dt.datetime.now().isoformat(timespec="seconds"),
        "modes": [{"name": m.name, "views": build_views(board, km, m)}
                  for m in find_modes(board, km.layers)],
    }


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(**values):
    state = load_state() | values
    try:
        STATE_FILE.write_text(json.dumps(state) + "\n")
    except OSError:
        pass


def notify(title: str, body: str):
    try:
        subprocess.run(["notify-send", "-a", "NuPhy Keymap", "-i", "input-keyboard", title, body],
                       check=False, stderr=subprocess.DEVNULL)
    except OSError:
        print(f"{title}: {body}", file=sys.stderr)


def kde_accent() -> str:
    """The desktop's accent color, lifted so it reads on the dark overlay."""
    try:
        text = (Path.home() / ".config" / "kdeglobals").read_text()
        if m := re.search(r"^AccentColor=(\d+),(\d+),(\d+)", text, re.M):
            h, l, s = colorsys.rgb_to_hls(*(int(v) / 255 for v in m.groups()))
            r, g, b = colorsys.hls_to_rgb(h, max(l, 0.64), max(s, 0.42))
            return f"#{int(r * 255):02x}{int(g * 255):02x}{int(b * 255):02x}"
    except OSError:
        pass
    return "#cdb575"


def claim_overlay() -> bool:
    """Toggle: if an overlay is already open, close it and return False."""
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(RUNTIME_DIR / "nuphy-keymap.pid", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        try:
            os.kill(int(os.pread(fd, 16, 0).decode()), signal.SIGTERM)
        except (ValueError, ProcessLookupError, PermissionError):
            pass
        os.close(fd)
        return False
    os.ftruncate(fd, 0)
    os.pwrite(fd, str(os.getpid()).encode(), 0)
    globals()["_overlay_lock_fd"] = fd  # the lock lives as long as this process
    return True


# ---------------------------------------------------------------------------
# The overlay (PyQt6): a dimmed full-screen layer with the keyboard card
# ---------------------------------------------------------------------------

DARK = {"ink": "#f1efea", "base": "#e9e6df", "muted": "#9b9ea6", "dim": "#70737c",
        "l1": "#6cb5ff", "l2": "#ffad5c", "l3": "#6bdc96", "l4": "#c79dff",
        "l5": "#ff8fa3", "l6": "#5fd6d6"}


def run_overlay(model: dict, screenshot: Path | None = None):
    from PyQt6.QtCore import QEasingCurve, QEvent, QPointF, QRectF, Qt, QTimer, QVariantAnimation
    from PyQt6.QtGui import (QColor, QFont, QFontMetricsF, QLinearGradient, QPainter,
                             QPainterPath, QPen)
    from PyQt6.QtWidgets import QApplication, QToolTip, QWidget

    palette = DARK | {"accent": kde_accent()}
    UI, CAP = "Fira Sans", "Fira Sans Condensed"
    W = QFont.Weight
    modes = model["modes"]
    names = [m["name"] for m in modes]
    wanted = load_state().get("mode")
    start_mode = names.index(wanted) if wanted in names else names.index("Windows") if "Windows" in names else 0

    def font(family: str, px: float, weight=W.Normal) -> QFont:
        f = QFont(family)
        f.setPixelSize(max(1, round(px)))
        f.setWeight(weight)
        return f

    def color(role: str, alpha: float = 1.0) -> QColor:
        c = QColor(palette.get(role, role))
        c.setAlphaF(alpha)
        return c

    def mix(a: QColor, b: QColor, t: float) -> QColor:
        return QColor.fromRgbF(a.redF() + (b.redF() - a.redF()) * t,
                               a.greenF() + (b.greenF() - a.greenF()) * t,
                               a.blueF() + (b.blueF() - a.blueF()) * t, 1.0)

    def tooltip_html(kv: dict) -> str:
        rows = []
        for t in kv["tip"]:
            note = f" <i>({html.escape(t['note'])})</i>" if t["note"] else ""
            rows.append(
                f"<tr><td style='color:{palette.get(t['role'], palette['ink'])};padding-right:10px'>"
                f"<b>{html.escape(t['layer'])}</b></td><td><b>{html.escape(t['text'])}</b> · "
                f"{html.escape(t['desc'])}{note}<br><span style='color:#8d9099'>"
                f"{html.escape(t['code'])}</span></td></tr>")
        return "<table cellspacing=3>" + "".join(rows) + "</table>"

    class Overlay(QWidget):
        def __init__(self):
            super().__init__()
            self.mode_i, self.view_i = start_mode, 0
            self.fade, self.hover, self.was_active = 0.0, None, False
            self.backdrop = True  # off when rendering screenshots
            self.hits: list[tuple[QRectF, str, object]] = []
            self.card = QRectF()
            self.fit_cache: dict = {}
            self.setWindowTitle("NuPhy Keymap")
            self.setWindowFlags(Qt.WindowType.FramelessWindowHint | Qt.WindowType.WindowStaysOnTopHint)
            self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)
            self.setMouseTracking(True)
            self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
            self.anim = QVariantAnimation(self)
            self.anim.setStartValue(0.0)
            self.anim.setEndValue(1.0)
            self.anim.setDuration(150)
            self.anim.setEasingCurve(QEasingCurve.Type.OutCubic)
            self.anim.valueChanged.connect(self._fade_to)

        def _fade_to(self, value):
            self.fade = float(value)
            self.update()

        @property
        def views(self) -> list[dict]:
            return modes[self.mode_i]["views"]

        @property
        def view(self) -> dict:
            return self.views[min(self.view_i, len(self.views) - 1)]

        # -- geometry -------------------------------------------------------
        def layout(self):
            bw, bh = model["board"]["w"], model["board"]["h"]
            u = max(40.0, min(76.0, (self.width() - 160) / (bw + 1.0), (self.height() - 300) / bh))
            pad, head, foot = 0.5 * u, 100.0, 62.0
            cw, ch = bw * u + 2 * pad, head + bh * u + foot
            card = QRectF((self.width() - cw) / 2, (self.height() - ch) / 2, cw, ch)
            return u, pad, head, card, QPointF(card.left() + pad, card.top() + head)

        # -- painting -------------------------------------------------------
        def paintEvent(self, _event):
            p = QPainter(self)
            p.setRenderHints(QPainter.RenderHint.Antialiasing | QPainter.RenderHint.TextAntialiasing)
            p.setOpacity(self.fade)
            if self.backdrop:
                p.fillRect(self.rect(), QColor(7, 8, 11, 170))
            u, pad, head, card, origin = self.layout()
            self.card, self.hits = card, []

            for i in range(1, 13):  # soft shadow under the card
                shadow = QPainterPath()
                shadow.addRoundedRect(card.adjusted(-i * 2, -i * 2 + 10, i * 2, i * 2 + 10), 22 + i * 2, 22 + i * 2)
                p.fillPath(shadow, QColor(0, 0, 0, max(0, 24 - 2 * i)))
            body = QPainterPath()
            body.addRoundedRect(card, 22, 22)
            g = QLinearGradient(card.topLeft(), card.bottomLeft())
            g.setColorAt(0, QColor("#25272d"))
            g.setColorAt(1, QColor("#1b1c21"))
            p.fillPath(body, g)
            p.setPen(QPen(QColor(255, 255, 255, 24), 1))
            p.drawPath(body)

            self.paint_header(p, card, pad)
            for kv in self.view["keys"]:
                r = QRectF(origin.x() + kv["x"] * u, origin.y() + kv["y"] * u,
                           kv["w"] * u, kv["h"] * u).adjusted(2.5, 2.5, -2.5, -2.5)
                self.paint_key(p, kv, r, u)
                self.hits.append((r, "key", kv))
            self.paint_footer(p, card, pad, origin.y() + model["board"]["h"] * u)

        def paint_header(self, p, card, pad):
            x, y = card.left() + pad, card.top() + 26
            p.setFont(font(CAP, 27, W.DemiBold))
            fm = QFontMetricsF(p.font())
            p.setPen(color("ink"))
            p.drawText(QPointF(x, y + fm.ascent()), model["board"]["name"])
            # Windows | Mac switch
            p.setFont(font(UI, 13, W.Medium))
            fs = QFontMetricsF(p.font())
            sx, sy, sh = x + fm.horizontalAdvance(model["board"]["name"]) + 18, y + (fm.height() - 28) / 2, 28.0
            frame = QRectF(sx, sy, sum(fs.horizontalAdvance(n) + 26 for n in names) + 6, sh)
            outline = QPainterPath()
            outline.addRoundedRect(frame, sh / 2, sh / 2)
            p.setPen(QPen(QColor(255, 255, 255, 40), 1))
            p.drawPath(outline)
            sx += 3
            for i, name in enumerate(names):
                r = QRectF(sx, sy + 3, fs.horizontalAdvance(name) + 26, sh - 6)
                if i == self.mode_i:
                    pill = QPainterPath()
                    pill.addRoundedRect(r, r.height() / 2, r.height() / 2)
                    p.fillPath(pill, color("ink", 0.92))
                    p.setPen(QColor("#1d1e23"))
                else:
                    p.setPen(color("muted"))
                p.drawText(r, Qt.AlignmentFlag.AlignCenter, name)
                self.hits.append((r, "mode", i))
                sx += r.width()
            # where the keymap came from
            src = model["source"]
            line = src["headline"] + (f" · {src['note']}" if src["note"] else "")
            p.setFont(font(UI, 13.5))
            p.setPen(color("muted"))
            p.drawText(QPointF(x, y + fm.height() + 6 + QFontMetricsF(p.font()).ascent()), line)
            # layer tabs, right-aligned
            p.setFont(font(UI, 13.5, W.Medium))
            ft = QFontMetricsF(p.font())
            widths = [ft.horizontalAdvance(v["title"]) + 28 for v in self.views]
            tx = card.right() - pad - sum(widths) - 6 * (len(widths) - 1)
            for i, (v, tw) in enumerate(zip(self.views, widths)):
                r = QRectF(tx, y + 1, tw, 32)
                pill = QPainterPath()
                pill.addRoundedRect(r, 16, 16)
                if i == self.view_i:
                    p.fillPath(pill, color(v["role"], 0.18))
                    p.setPen(QPen(color(v["role"], 0.85), 1.2))
                    p.drawPath(pill)
                    p.setPen(color(v["role"]))
                else:
                    p.setPen(QPen(QColor(255, 255, 255, 30), 1))
                    p.drawPath(pill)
                    p.setPen(color("muted"))
                p.drawText(r, Qt.AlignmentFlag.AlignCenter, v["title"])
                self.hits.append((r, "view", i))
                tx += tw + 6

        def paint_footer(self, p, card, pad, top):
            y = top + 22
            p.setFont(font(UI, 13))
            fm = QFontMetricsF(p.font())
            x = card.left() + pad
            for role, text in self.view["chips"]:
                dot = QRectF(x, y + (fm.height() - 11) / 2, 11, 11)
                path = QPainterPath()
                path.addRoundedRect(dot, 3, 3)
                if text.startswith("Outlined"):
                    p.setPen(QPen(color(role), 1.6))
                    p.drawPath(path)
                elif role == "dim":
                    p.fillPath(path, QColor("#3a3c43"))
                else:
                    p.fillPath(path, color(role))
                p.setPen(color("muted"))
                p.drawText(QPointF(x + 18, y + fm.ascent()), text)
                x += 18 + fm.horizontalAdvance(text) + 26
            if self.view["summary"]:
                p.setPen(color(self.view["role"]))
                p.drawText(QPointF(x, y + fm.ascent()), f"{self.view['title']}: {self.view['summary']}")
            hint = "Tab / ← → switch views   ·   M  Windows/Mac   ·   Esc  close"
            p.setPen(color("dim"))
            p.drawText(QPointF(card.right() - pad - fm.horizontalAdvance(hint), y + fm.ascent()), hint)

        def paint_key(self, p, kv, r, u):
            radius = u * 0.13
            skirt, top, bottom = QColor("#121317"), QColor("#3b3e46"), QColor("#30333a")
            if kv["tint"]:
                c = color(kv["tint"])
                skirt, top, bottom = mix(skirt, c, 0.2), mix(top, c, 0.36), mix(bottom, c, 0.28)
            if kv["dim"]:
                base = QColor("#202227")
                top, bottom = mix(top, base, 0.55), mix(bottom, base, 0.55)
            outer = QPainterPath()
            outer.addRoundedRect(r, radius, radius)
            p.fillPath(outer, skirt)
            face = r.adjusted(u * 0.055, u * 0.035, -u * 0.055, -u * 0.105)
            g = QLinearGradient(face.topLeft(), face.bottomLeft())
            g.setColorAt(0, top)
            g.setColorAt(1, bottom)
            inner = QPainterPath()
            inner.addRoundedRect(face, radius * 0.75, radius * 0.75)
            p.fillPath(inner, g)
            if kv["held"]:
                p.setPen(QPen(color(kv["held"]), 2.2))
                p.drawPath(outer)
            elif self.hover == kv["i"]:
                p.setPen(QPen(QColor(255, 255, 255, 80), 1.3))
                p.drawPath(outer)
            self.paint_legends(p, kv, face, u)

        def paint_legends(self, p, kv, face, u):
            box = face.adjusted(u * 0.08, u * 0.05, -u * 0.08, -u * 0.06)
            overview = self.view["id"] == "overview"
            slots = {"corner": [], "main": [], "sub": []}
            for lg in kv["legends"]:
                slots[lg["slot"]].append(lg)
            if slots["corner"]:
                lg = slots["corner"][0]
                px = u * (0.2 if overview else 0.142)
                h = px * 1.35
                lines, f = self.fit(lg["v"], box.width(), h, px, px * 0.72, 1, W.DemiBold if overview else W.Medium, 0.9)
                p.setFont(f)
                p.setPen(color(lg["role"], 0.95 if overview else 0.55))
                p.drawText(QRectF(box.left(), box.top(), box.width(), h),
                           Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignTop, lines[0])
            if slots["main"]:
                lg = slots["main"][0]
                top = box.top() + (u * 0.17 if slots["corner"] else 0)
                area = QRectF(box.left(), top, box.width(), box.bottom() - top)
                weight = W.DemiBold if kv["tint"] or kv["held"] else W.Medium
                lines, f = self.fit(lg["v"], area.width(), area.height(), u * 0.205, u * 0.13, 2, weight)
                p.setFont(f)
                p.setPen(color(lg["role"]))
                lh = QFontMetricsF(f).height()
                y = area.top() + (area.height() - lh * len(lines)) / 2
                for line in lines:
                    p.drawText(QRectF(area.left(), y, area.width(), lh), Qt.AlignmentFlag.AlignCenter, line)
                    y += lh
            if slots["sub"]:
                px = u * 0.158
                lh = px * 1.25
                y = box.bottom()
                for lg in reversed(slots["sub"][:2]):
                    lines, f = self.fit(lg["v"], box.width(), lh, px, u * 0.118, 1, W.DemiBold, 0.9)
                    p.setFont(f)
                    p.setPen(color(lg["role"]))
                    p.drawText(QRectF(box.left(), y - lh, box.width(), lh),
                               Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignBottom, lines[0])
                    y -= lh

        def fit(self, variants, width, height, px, min_px, max_lines, weight, comfort=0.75):
            """The most descriptive variant that fits at a comfortable size; failing
            that, any variant down to min_px; failing that, the shortest, elided."""
            key = (tuple(variants), round(width), round(height), round(px), round(min_px), max_lines, weight, comfort)
            if key in self.fit_cache:
                return self.fit_cache[key]

            def fits(v, size):
                lines = v.split("\n")
                if len(lines) > max_lines:
                    return None
                f = font(CAP, size, weight)
                fm = QFontMetricsF(f)
                if fm.height() * len(lines) <= height + 1 and max(fm.horizontalAdvance(s) for s in lines) <= width:
                    return lines, f
                return None

            result = None
            comfortable = round(max(min_px, px * comfort))
            for low, high in ((comfortable, round(px)), (round(min_px), comfortable - 1)):
                for v in variants:
                    size = high
                    while size >= low and not (result := fits(v, size)):
                        size -= 1
                    if result:
                        break
                if result:
                    break
            if result is None:
                f = font(CAP, min_px, weight)
                text = QFontMetricsF(f).elidedText(flat(variants[-1]), Qt.TextElideMode.ElideRight, width)
                result = ([text], f)
            self.fit_cache[key] = result
            return result

        # -- interaction ----------------------------------------------------
        def hit(self, pos):
            return next((h for h in self.hits if h[0].contains(pos)), None)

        def mouseMoveEvent(self, e):
            h = self.hit(e.position())
            hover = h[2]["i"] if h and h[1] == "key" else None
            if h and h[1] == "key":
                QToolTip.showText(e.globalPosition().toPoint(), tooltip_html(h[2]), self)
            else:
                QToolTip.hideText()
            self.setCursor(Qt.CursorShape.PointingHandCursor if h and h[1] in ("view", "mode")
                           else Qt.CursorShape.ArrowCursor)
            if hover != self.hover:
                self.hover = hover
                self.update()

        def mousePressEvent(self, e):
            h = self.hit(e.position())
            if h and h[1] == "view":
                self.view_i = h[2]
                self.update()
            elif h and h[1] == "mode":
                self.set_mode(h[2])
            elif not self.card.contains(e.position()):
                self.close()

        def set_mode(self, i: int):
            self.mode_i = i % len(modes)
            self.view_i = min(self.view_i, len(self.views) - 1)
            save_state(mode=names[self.mode_i])
            self.update()

        def focusNextPrevChild(self, _next):  # let Tab reach keyPressEvent
            return False

        def keyPressEvent(self, e):
            k, K = e.key(), Qt.Key
            if k in (K.Key_Escape, K.Key_Q, K.Key_Space, K.Key_Return, K.Key_Enter, K.Key_F19):
                self.close()
            elif k in (K.Key_Tab, K.Key_Right, K.Key_L, K.Key_PageDown):
                self.view_i = (self.view_i + 1) % len(self.views)
                self.update()
            elif k in (K.Key_Backtab, K.Key_Left, K.Key_H, K.Key_PageUp):
                self.view_i = (self.view_i - 1) % len(self.views)
                self.update()
            elif K.Key_1 <= k <= K.Key_9 and k - K.Key_1 < len(self.views):
                self.view_i = k - K.Key_1
                self.update()
            elif k in (K.Key_M, K.Key_W):
                self.set_mode(self.mode_i + 1)

        def showEvent(self, e):
            super().showEvent(e)
            self.anim.start()
            self.activateWindow()

        def changeEvent(self, e):
            if e.type() == QEvent.Type.ActivationChange:  # click elsewhere closes it
                if self.isActiveWindow():
                    self.was_active = True
                elif self.was_active:
                    QTimer.singleShot(150, lambda: self.isActiveWindow() or self.close())
            super().changeEvent(e)

    app = QApplication([sys.argv[0]])
    app.setApplicationName("nuphy-keymap")
    app.setDesktopFileName("nuphy-keymap")
    overlay = Overlay()
    if screenshot:  # render offscreen: one image per mode and view, cropped to the card
        overlay.resize(1920, 1080)
        overlay.fade, overlay.backdrop = 1.0, False
        for m in range(len(modes)):
            overlay.mode_i = m
            for v in range(len(overlay.views)):
                overlay.view_i = v
                image = overlay.grab()
                image = image.copy(overlay.card.adjusted(-28, -20, 28, 36).toAlignedRect())
                image.save(str(screenshot.with_name(f"{screenshot.stem}-{names[m]}-{v}{screenshot.suffix}")))
        return
    overlay.showFullScreen()
    app.exec()


# ---------------------------------------------------------------------------
# HTML page (also publishable as a Claude artifact with --fragment)
# ---------------------------------------------------------------------------

HTML_HEAD = r"""<title>Air60 V2 Keymap</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Mono:wght@400;500&family=Fira+Sans+Condensed:wght@400;500;600;700&family=Fira+Sans:wght@400;500;600&display=swap">
<style>
/* Layout: a keycap reference card. Name and Windows/Mac switch on top, layer
   tabs, the board scaled to the column (it scrolls sideways on a phone), a
   legend strip, then a detail card for whichever key is selected. */
:root {
  --paper: #ecebe6;
  --case: #d8d6cf;
  --cap: #fbfaf7;
  --cap-low: #e9e7e0;
  --skirt: #c2bfb6;
  --ink: #22211d;
  --muted: #67645c;
  --line: #c9c6be;
  --accent: #7a6532;
  --l1: #1c69cc; --l2: #b55804; --l3: #137a44; --l4: #7446c2; --l5: #bd3657; --l6: #0e7a80;
  --font-ui: "Fira Sans", "Noto Sans", system-ui, sans-serif;
  --font-cap: "Fira Sans Condensed", "Fira Sans", "Noto Sans", sans-serif;
  --font-code: "Fira Mono", "Hack", ui-monospace, monospace;
}
@media (prefers-color-scheme: dark) {
